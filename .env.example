# Example environment variables (no secrets). All features below are optional —
# local writing works with none of these set.

# AI suggestions + Reflection mode
ANTHROPIC_API_KEY=

# Place names for entry locations (Places API (New) + Geocoding API). Without it
# the free OpenStreetMap-based Photon service is used instead.
GOOGLE_MAPS_API_KEY=

# Private sync (Supabase + passkeys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared entries (beta): 1 shows the feature (Settings → Sync switch); unset hides it.
VITE_SHARED_ENTRIES=
# Shared entries' live editing: the anon / publishable key (public by design).
SUPABASE_ANON_KEY=
SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Present
WEBAUTHN_ORIGIN=https://localhost:5173

# Umami analytics (public, inlined at build). Leave the id empty to skip Umami.
# VITE_UMAMI_SRC defaults to Umami Cloud; set it to a self-hosted /script.js.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=
