# Example environment variables (no secrets). All features below are optional —
# local writing works with none of these set.

# AI suggestions + Reflection mode
ANTHROPIC_API_KEY=

# Voice dictation
DEEPGRAM_API_KEY=

# Place names for entry locations (Places API (New) + Geocoding API). Without it
# the free OpenStreetMap-based Photon service is used instead.
GOOGLE_MAPS_API_KEY=

# Private sync (Supabase + passkeys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Present
WEBAUTHN_ORIGIN=https://localhost:5173
